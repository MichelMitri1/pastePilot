<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Menu bar app: no Dock icon, no app switcher entry. -->
  <key>LSUIElement</key>
  <true/>
  <!-- Voice commands: the microphone is only used while you hold the voice shortcut. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>PastePilot listens only while you hold the voice shortcut, to understand commands like “reply to this”.</string>
</dict>
</plist>
